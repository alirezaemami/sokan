# Origin of the Frappe backend serving the sokan site.
#
# This bench runs with serve_default_site=true, so port 8000 will NOT serve
# sokan.local regardless of Host header. In development run a dedicated server:
#
#     bench --site sokan.local serve --port 8002
#
# In production nginx routes /api and /files to Frappe on the same origin, so
# this becomes the internal Frappe address.
NUXT_PUBLIC_FRAPPE_API_BASE=http://127.0.0.1:8002

# Public canonical origin. Canonical tags, hreflang, og:image and sitemap
# entries are built from this — it MUST be the real domain in production.
NUXT_PUBLIC_SITE_URL=https://sokan.app
