# Origin of the Frappe backend. In development: the `bench start` web server.
# In production nginx routes /api and /files to Frappe on the same origin, so
# this becomes the internal Frappe address.
NUXT_PUBLIC_FRAPPE_API_BASE=http://127.0.0.1:8000

# The Frappe site to talk to. Sent as X-Frappe-Site-Name, so it works on a
# multi-site bench whatever the default site is.
NUXT_FRAPPE_SITE_NAME=sokan.local

# Public canonical origin. Canonical tags, hreflang, og:image and sitemap
# entries are built from this — it MUST be the real domain in production.
NUXT_PUBLIC_SITE_URL=https://www.sokan.net
